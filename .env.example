# Copy to .env on local iron. Never commit real values.

# Jessica (public client only). Leave empty to run the desk offline.
JESSICA_BASE_URL=
JESSICA_WEBHOOK_SECRET=

# Super Grok OAuth. Presence marks the lane configured. Values never leave this file into git.
XAI_OAUTH_CLIENT_ID=
XAI_OAUTH_CLIENT_SECRET=
XAI_OAUTH_TOKEN=

# File Explorer ACL. Root is jailed. "some" uses FILE_ACL_ALLOW prefixes.
FILE_ACL_MODE=some
FILE_ACL_ROOT=./fixtures/iron
FILE_ACL_ALLOW=public,notes

# Desk
DESK_PORT=3344
ACTIVE_PROFILE=cap
